# --- OS noise ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# --- Editors / IDEs ---
.idea/
.vscode/
*.iml
*.swp
*.swo
.project
.settings/
.history/

# --- Local tooling and build output ---
.tools/
bin/
dist/
tmp/
*.tmp
*.log
coverage.out
*.test
*.out

# --- Helm ---
charts/*/charts/*.tgz
*.tgz
charts/*/tmpcharts/
.cr-release-packages/
.cr-index/

# --- Kubernetes / cluster access ---
kubeconfig
*.kubeconfig
kubeconfig*.yaml
examples/kind/kubeconfig
talosconfig
**/talosconfig

# --- Secrets and credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
secrets.yaml
secrets.*.yaml
*.secret.yaml
*-secret.yaml
values.local.yaml
# scripts/buildkit-certs.sh output (CA and client keys)
buildkit-certs/
kind-certs/
*.local.yaml
.docker/config.json
.netrc

# Chart templates, chart tests and e2e fixtures are code, never secrets: keep
# them even when a name matches a pattern above (templates/tls-secret.yaml).
!charts/**/templates/**
!charts/**/tests/**
!test/e2e/fixtures/**

# --- build outputs ---
/ci-accelerator
/console
/.ui-shots/
