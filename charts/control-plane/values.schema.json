{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "gitlab", "daemons", "tls", "jobs", "retention", "controller", "web", "router"],
  "properties": {
    "enabled": { "type": "boolean", "description": "The switch a parent chart uses to include this one." },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "gitlab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urls", "urlsFrom"],
      "properties": {
        "urls": { "type": "array", "items": { "type": "string", "pattern": "^https?://[^\\s,]+$" } },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "urlsFrom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configMap", "key"],
          "properties": { "configMap": { "type": "string" }, "key": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "caches": {
      "type": "object",
      "additionalProperties": false,
      "description": "The runners' S3 cache folders the controller lists.",
      "properties": {
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "server": { "type": "string" },
              "bucket": { "type": "string" },
              "region": { "type": "string" },
              "path": { "type": "string" },
              "gitlabUrl": { "type": "string", "pattern": "^https?://[^\\s,]+$" },
              "existingSecret": { "type": "string" },
              "insecure": { "type": "boolean" },
              "pathStyle": { "type": "boolean" }
            }
          }
        },
        "fromConfigMap": { "type": "string" },
        "key": { "type": "string", "minLength": 1 },
        "every": {
          "type": "string",
          "pattern": "^([1-9][0-9]+s|[1-9][0-9]*(m|h))$",
          "description": "How often the bucket is listed: at least 10s (10m by default)."
        }
      }
    },
    "signIn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "url", "sessionKey", "gitlab"],
      "description": "Sign-in through GitLab.",
      "properties": {
        "enabled": { "type": "boolean" },
        "url": {
          "type": "string",
          "description": "Where browsers reach the console; default global.console.url."
        },
        "sessionKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "gitlab": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["existingSecret"],
            "properties": {
              "url": { "type": "string", "pattern": "^(https?://[^\\s,]+)?$" },
              "existingSecret": { "type": "string" },
              "admins": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_.-]*$" }
              }
            }
          }
        }
      }
    },
    "daemons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discover", "serverName"],
      "properties": {
        "discover": { "type": "string" },
        "serverName": { "type": "string" },
        "diskProbePort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "cachePersists": { "type": "boolean" }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "certManager"],
      "properties": {
        "existingSecret": { "type": "string" },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuerRef", "duration", "renewBeforePercentage"],
          "properties": {
            "issuerRef": { "$ref": "#/$defs/issuerRef" },
            "duration": { "type": "string", "pattern": "^[0-9]{1,6}h$" },
            "renewBeforePercentage": { "type": "integer", "minimum": 5, "maximum": 95 }
          }
        }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "rbac"],
      "properties": {
        "namespace": { "type": "string" },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "required": ["create"],
          "properties": { "create": { "type": "boolean" } }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "outputDays"],
      "properties": {
        "days": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "outputDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistence",
        "api",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podLabels",
        "podAnnotations"
      ],
      "properties": {
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "storageClass", "existingClaim"],
          "properties": {
            "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)$" },
            "storageClass": { "type": "string" },
            "existingClaim": { "type": "string" }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "clusterDomain": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "existingSecret": { "type": "string" } },
              "required": ["existingSecret"]
            }
          },
          "required": ["port", "clusterDomain", "tls"]
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
            "requests": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
            "claims": { "type": "array" }
          }
        },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 20 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
            "requests": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
            "claims": { "type": "array" }
          }
        },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "required": [
        "replicas",
        "port",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podLabels",
        "podAnnotations"
      ]
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "routing": { "enum": ["PreferSameNode", "Local", "Cluster"] },
        "zones": { "type": "boolean" },
        "crossZone": { "type": "boolean" },
        "overloadBuilds": { "type": "integer", "minimum": 0 },
        "warmDays": { "type": "integer", "minimum": 1, "maximum": 90 },
        "drainSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "preStopSleepSeconds": { "type": "integer", "minimum": 0, "maximum": 60 },
        "priorityClassName": { "type": "string" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
            "requests": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
            "claims": { "type": "array" }
          }
        },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "clientNamespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "enabled",
        "port",
        "healthPort",
        "routing",
        "crossZone",
        "overloadBuilds",
        "warmDays",
        "drainSeconds",
        "preStopSleepSeconds",
        "priorityClassName",
        "resources",
        "nodeSelector",
        "tolerations",
        "podLabels",
        "podAnnotations",
        "clientNamespaces"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "deniedNamespaces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "deniedComponents": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "extraFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "global": { "type": "object" }
  },
  "$defs": {
    "issuerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "group"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["Issuer", "ClusterIssuer"] },
        "group": { "type": "string", "minLength": 1 }
      }
    }
  }
}
