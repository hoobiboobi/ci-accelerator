{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "buildkit chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "preflight",
    "global",
    "tls",
    "service",
    "storage",
    "config",
    "probes",
    "updateStrategy",
    "terminationGracePeriodSeconds",
    "preStopSleepSeconds",
    "minReadySeconds"
  ],
  "definitions": {
    "diskSpace": {
      "description": "buildkit size, binary units: bytes, 512MB, 2TB, 10GiB (10GB = 10 GiB), or a percentage of the state-dir filesystem (75%). Not Kubernetes quantities: 10Gi is rejected. Empty means not rendered.",
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)? ?([kKmMgGtTpP]([iI]?[bB])?|[bB])?|[0-9]{1,2}%|100%)?$"
    },
    "duration": {
      "description": "Seconds or a Go duration (48h, 336h, 90m). Go has no 'd' unit. Empty means not rendered.",
      "type": "string",
      "pattern": "^([0-9]{1,9}|([0-9]{1,6}(\\.[0-9]{1,9})?(ns|us|µs|ms|s|m|h))+)?$"
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "probeWithGrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "gcFilter": {
      "description": "buildkit prune filter: comma-separated field==value / field!=value / field~=regex terms, or a bare boolean field. Fields: id, parents, description, inuse, mutable, immutable, type, shared, private.",
      "type": "string",
      "pattern": "^(id|parents|description|inuse|mutable|immutable|type|shared|private)((==|!=|~=)[^,]+)?(,(id|parents|description|inuse|mutable|immutable|type|shared|private)((==|!=|~=)[^,]+)?)*$"
    },
    "gcPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": { "type": "boolean" },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/definitions/gcFilter" }
        },
        "keepDuration": { "$ref": "#/definitions/duration" },
        "reservedSpace": { "$ref": "#/definitions/diskSpace" },
        "maxUsedSpace": { "$ref": "#/definitions/diskSpace" },
        "minFreeSpace": { "$ref": "#/definitions/diskSpace" }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tomlScalar": { "type": ["string", "number", "boolean"] },
    "intOrPercent": {
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]{1,3}%$" }]
    },
    "dnsLabelOrEmpty": { "type": "string", "maxLength": 63, "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$" }
  },
  "properties": {
    "nameOverride": { "$ref": "#/definitions/dnsLabelOrEmpty" },
    "fullnameOverride": { "$ref": "#/definitions/dnsLabelOrEmpty" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "commonLabels": { "$ref": "#/definitions/stringMap" },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["podSecurity", "buildNodes", "tlsSecret"],
      "properties": {
        "podSecurity": { "type": "boolean" },
        "buildNodes": { "type": "boolean" },
        "tlsSecret": { "type": "boolean" }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "reloader"],
      "properties": {
        "existingSecret": {
          "description": "Secret name (DNS subdomain) in the release namespace with tls.crt, tls.key and ca.crt. Required: the chart refuses to render without it.",
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
        },
        "reloader": { "type": "boolean" }
      }
    },
    "global": {
      "description": "Shared with other ci-accelerator charts; unknown keys belong to them.",
      "type": "object",
      "required": ["buildNodes"],
      "properties": {
        "buildNodes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "selector": { "$ref": "#/definitions/stringMap" },
            "tolerations": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "routing", "externalTrafficPolicy"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": {
          "description": "Empty, or a port inside the cluster's service-node-port-range (default 30000-32767). The API server checks the range; a server-side dry run does not.",
          "oneOf": [
            { "type": "string", "maxLength": 0 },
            { "type": "integer", "minimum": 1, "maximum": 65535 }
          ]
        },
        "routing": { "type": "string", "enum": ["PreferSameNode", "Local", "Cluster"] },
        "externalTrafficPolicy": { "type": "string", "enum": ["Cluster", "Local"] },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "emptyDir", "hostPath"],
      "properties": {
        "type": { "type": "string", "enum": ["emptyDir", "hostPath"] },
        "emptyDir": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sizeLimit"],
          "properties": {
            "sizeLimit": {
              "description": "Kubernetes quantity (50Gi, 500M) or empty.",
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?)?$"
            }
          }
        },
        "hostPath": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "type"],
          "properties": {
            "path": { "type": "string", "pattern": "^(/[^\\s]*)?$" },
            "type": { "type": "string", "enum": ["Directory", "DirectoryOrCreate"] }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxParallelism",
        "gc",
        "gcPolicy",
        "history",
        "cdi",
        "maxRegistryConcurrency",
        "workerOCI",
        "extraConfig"
      ],
      "properties": {
        "maxParallelism": { "type": "integer", "minimum": 0 },
        "gc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reservedSpace", "maxUsedSpace", "minFreeSpace", "cacheMounts"],
          "properties": {
            "reservedSpace": { "$ref": "#/definitions/diskSpace" },
            "maxUsedSpace": { "$ref": "#/definitions/diskSpace" },
            "minFreeSpace": { "$ref": "#/definitions/diskSpace" },
            "cacheMounts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["keepDuration"],
              "properties": {
                "keepDuration": { "$ref": "#/definitions/duration" },
                "maxUsedSpace": { "$ref": "#/definitions/diskSpace" }
              }
            }
          }
        },
        "gcPolicy": {
          "type": "array",
          "items": { "$ref": "#/definitions/gcPolicy" }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAge": { "$ref": "#/definitions/duration" },
            "maxEntries": { "type": "integer", "minimum": 0 }
          }
        },
        "cdi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "maxRegistryConcurrency": { "type": "integer", "minimum": 0 },
        "workerOCI": {
          "description": "Extra [worker.oci] keys (bare TOML keys). Checked at render time: the chart's own keys and invalid key names are rejected.",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/definitions/tomlScalar" },
              {
                "type": "array",
                "items": { "$ref": "#/definitions/tomlScalar" }
              }
            ]
          }
        },
        "extraConfig": { "type": "string" }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": { "$ref": "#/definitions/probeWithGrace" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probeWithGrace" }
      }
    },
    "resources": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
    "minReadySeconds": { "type": "integer", "minimum": 0 },
    "updateStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["RollingUpdate", "OnDelete"] },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxUnavailable": { "$ref": "#/definitions/intOrPercent" },
            "maxSurge": { "$ref": "#/definitions/intOrPercent" }
          }
        }
      }
    },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "extraEnv": { "type": "array", "items": { "type": "object" } }
  }
}
