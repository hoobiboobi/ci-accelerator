{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "buildkit chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "diskSpace": {
      "description": "Bytes, a size with unit (512MB, 2TB, 10GiB) or a percentage of the disk (75%). Empty means unset.",
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)? ?[kKmMgGtTpP]?[iI]?[bB]?|[0-9]{1,2}%|100%)?$"
    },
    "duration": {
      "description": "Seconds or a Go duration (48h, 336h, 90m). Go has no 'd' unit. Empty means unset.",
      "type": "string",
      "pattern": "^([0-9]+|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)?$"
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "gcPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": { "type": "boolean" },
        "filters": { "type": "array", "items": { "type": "string" } },
        "keepDuration": { "$ref": "#/definitions/duration" },
        "reservedSpace": { "$ref": "#/definitions/diskSpace" },
        "maxUsedSpace": { "$ref": "#/definitions/diskSpace" },
        "minFreeSpace": { "$ref": "#/definitions/diskSpace" }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "commonLabels": { "$ref": "#/definitions/stringMap" },
    "global": {
      "description": "Shared with other ci-accelerator charts; unknown keys belong to them.",
      "type": "object",
      "properties": {
        "buildNodes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "selector": { "$ref": "#/definitions/stringMap" },
            "tolerations": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": {
          "description": "Empty string or an integer in the node port range.",
          "oneOf": [
            { "type": "string", "maxLength": 0 },
            { "type": "integer", "minimum": 1, "maximum": 65535 }
          ]
        },
        "routing": { "type": "string", "enum": ["PreferSameNode", "Local", "Cluster"] },
        "externalTrafficPolicy": { "type": "string", "enum": ["Cluster", "Local"] },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["emptyDir", "hostPath"] },
        "emptyDir": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sizeLimit": { "type": "string" }
          }
        },
        "hostPath": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "pattern": "^/" }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxParallelism": { "type": "integer", "minimum": 0 },
        "gc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reservedSpace": { "$ref": "#/definitions/diskSpace" },
            "maxUsedSpace": { "$ref": "#/definitions/diskSpace" },
            "minFreeSpace": { "$ref": "#/definitions/diskSpace" },
            "cacheMounts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "keepDuration": { "$ref": "#/definitions/duration" },
                "maxUsedSpace": { "$ref": "#/definitions/diskSpace" }
              }
            }
          }
        },
        "gcPolicy": {
          "type": "array",
          "items": { "$ref": "#/definitions/gcPolicy" }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAge": { "$ref": "#/definitions/duration" },
            "maxEntries": { "type": "integer", "minimum": 0 }
          }
        },
        "cdi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "maxRegistryConcurrency": { "type": "integer", "minimum": 0 },
        "extraConfig": { "type": "string" }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "resources": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "updateStrategy": { "type": "object" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "extraEnv": { "type": "array", "items": { "type": "object" } }
  }
}
