matches the reviewed default config:
  1: |
    |
      # Rendered by the ci-accelerator buildkit chart. Do not edit in the cluster.
      root = "/var/lib/buildkit"

      [grpc]
        # unix socket: used by the probes, never TLS. tcp: used by CI jobs, mutual
        # TLS: with a CA set, buildkitd requires a client certificate signed by it.
        address = ["unix:///run/buildkit/buildkitd.sock", "tcp://0.0.0.0:1234"]

      [grpc.tls]
        cert = "/etc/buildkitd-tls/tls.crt"
        key = "/etc/buildkitd-tls/tls.key"
        ca = "/etc/buildkitd-tls/ca.crt"

      [history]
        maxAge = "48h"
        maxEntries = 1000

      [cdi]
        disabled = true

      [worker.oci]
        enabled = true
        gc = true

      [[worker.oci.gcpolicy]]
        filters = ["type==source.local","type==source.git.checkout"]
        keepDuration = "48h"
        maxUsedSpace = "512MB"

      [[worker.oci.gcpolicy]]
        filters = ["type==exec.cachemount"]
        keepDuration = "336h"

      [[worker.oci.gcpolicy]]
        keepDuration = "1440h"
        reservedSpace = "10GB"
        maxUsedSpace = "75%"
        minFreeSpace = "30%"

      [[worker.oci.gcpolicy]]
        reservedSpace = "10GB"
        maxUsedSpace = "75%"
        minFreeSpace = "30%"

      [[worker.oci.gcpolicy]]
        all = true
        reservedSpace = "10GB"
        maxUsedSpace = "75%"
        minFreeSpace = "30%"

      [worker.containerd]
        enabled = false
