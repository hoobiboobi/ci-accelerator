{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ci-accelerator chart values",
  "description": "Only this chart's own keys are typed; buildkit validates its block with its own schema, gitlab-runner's block is the upstream chart's.",
  "type": "object",
  "required": [
    "global",
    "jobsNamespace",
    "buildkit",
    "gitlab-runner",
    "preflight"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "buildNodes",
        "tls",
        "jobs"
      ],
      "properties": {
        "console": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "The console's address as users reach it; printed in every job's log.",
              "pattern": "^$|^https?://[^\\s\"'\\\\]+$"
            }
          }
        },
        "jobs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "architecture"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "architecture": {
              "type": "string",
              "enum": [
                "amd64",
                "arm64"
              ]
            }
          }
        }
      }
    },
    "jobsNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "podSecurity"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "podSecurity": {
          "type": "string",
          "enum": [
            "baseline",
            "restricted",
            "privileged"
          ]
        }
      }
    },
    "buildkit": {
      "type": "object"
    },
    "gitlab-runner": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gitlabUrl": {
          "type": "string",
          "pattern": "^(https?://[^\\s]+)?$"
        }
      }
    },
    "victoria-metrics-single": {
      "description": "Removed in 0.2.0: the box no longer installs it. Ignored; the install notes warn while it is set.",
      "type": ["object", "null"]
    },
    "victoria-traces-single": {
      "description": "Removed in 0.2.0: the box no longer installs it. Ignored; the install notes warn while it is set.",
      "type": ["object", "null"]
    },
    "runnerTiers": {
      "type": "object",
      "description": "More runners next to the main one, one pod each, keyed by tier name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "existingSecret": { "type": "string" },
              "key": { "type": "string", "minLength": 1 }
            }
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requests": { "type": "object", "additionalProperties": false, "properties": { "cpu": { "type": ["string", "number"] }, "memory": { "type": "string" } } },
              "limits": { "type": "object", "additionalProperties": false, "properties": { "cpu": { "type": ["string", "number"] }, "memory": { "type": "string" } } }
            }
          },
          "nodes": { "type": "string", "description": "any or build (checked by the templates, with a hint)" },
          "concurrent": { "type": "integer", "minimum": 1 },
          "image": { "type": "string" },
          "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
          "cache": {
          "type": "object",
          "additionalProperties": false,
          "description": "S3 cache: off without s3.server. The Secret holds accesskey and secretkey.",
          "properties": {
            "secretName": { "type": "string" },
            "consoleSecretName": { "type": "string", "description": "Keys the console reads the bucket with (default: secretName)." },
            "path": { "type": "string" },
            "maxArchiveBytes": { "type": "integer", "minimum": 1 },
            "s3": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "server": { "type": "string" },
                "bucket": { "type": "string" },
                "region": { "type": "string" },
                "insecure": { "type": "boolean" },
                "pathStyle": { "type": ["boolean", "string"] }
              }
            }
          }
        },
          "manager": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resources": { "type": "object" },
              "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
              "tolerations": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runnerSecret"
      ],
      "properties": {
        "runnerSecret": {
          "type": "boolean"
        }
      }
    }
  }
}
